# ── Required ─────────────────────────────────────────────────────────────────

# Your existing Ollypedia MongoDB Atlas URI (same as server.js)
MONGO_URI="mongodb://manupradhan7887:manu123@ac-disxnbk-shard-00-00.taqqdhs.mongodb.net:27017,ac-disxnbk-shard-00-01.taqqdhs.mongodb.net:27017,ac-disxnbk-shard-00-02.taqqdhs.mongodb.net:27017/?ssl=true&replicaSet=atlas-xqif1e-shard-0&authSource=admin&appName=Cluster0"

# TMDB API key (free at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=007d5a1ee9d14088bbca24e8c6d080ed

# Optional: uncomment only if you have a working external proxy.
# HTTPS_PROXY=http://127.0.0.1:10809

# ── Recommended ───────────────────────────────────────────────────────────────

# OMDb API key — enables IMDb ratings, awards (free tier: 1000 req/day)
# https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=30ad8e86

# YouTube Data API v3 key (for trailer search when TMDB doesn't have one)
# https://console.cloud.google.com/ → APIs → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── Optional ─────────────────────────────────────────────────────────────────

# If you already have a "Bollywood Auto-Import" Production in your DB,
# paste its MongoDB ObjectId here to skip auto-creation.
# Leave blank and the scraper will create one automatically.
SCRAPER_PRODUCTION_ID=

# Site URL (used for logging only)
SITE_URL=https://www.ollypedia.in
